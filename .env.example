# Pooled Neon Postgres connection string. Keep this server-side; do not prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional non-owner Neon read-only role for public catalogue queries. SQL policies still require published, non-archived recipes.
DATABASE_READONLY_URL=

# At least 32 random bytes. Use a distinct value per deployment environment.
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Public canonical origin used for SEO and trusted authentication origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated administrator identities. `npm run db:seed` inserts these addresses into admin_users.
ADMIN_EMAILS=admin@example.com

# Required only for protected editorial photo uploads/deletion from Vercel Blob.
BLOB_READ_WRITE_TOKEN=
